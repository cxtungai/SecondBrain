---
import { CREDIBILITY } from '../lib/schema.mjs';

interface Props {
  score?: number | null;
  /** Hiện nhãn chữ (Cao, Trung bình…) */
  label?: boolean;
  title?: string;
}
const { score, label = false, title } = Astro.props;
const value = typeof score === 'number' ? Math.round(score) : null;
const info = value ? CREDIBILITY[value as keyof typeof CREDIBILITY] : null;
const tip = title ?? (info ? `Uy tín ${score}/5 — ${info.label}: ${info.description}` : 'Chưa chấm điểm uy tín');
---

<span class={`cred cred-${value ?? 'none'}`} title={tip} aria-label={tip}>
  <span class="cred-dots" aria-hidden="true">
    {[1, 2, 3, 4, 5].map((i) => <span class={value && i <= value ? 'on' : ''} />)}
  </span>
  <span class="cred-text">{value ? `${score}/5` : 'chưa chấm'}{label && info ? ` · ${info.label}` : ''}</span>
</span>
