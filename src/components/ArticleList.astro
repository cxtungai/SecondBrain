---
import type { Article } from '../lib/posts';
import { ARTICLE_INTENTS } from '../lib/articles.mjs';
import { articleUrl, formatDate } from '../lib/urls';

interface Props {
  articles: Article[];
  empty?: string;
}
const { articles, empty = 'Chưa có bài viết nào.' } = Astro.props;
---

{articles.length === 0 ? (
  <p class="empty">{empty}</p>
) : (
  <ul class="note-list">
    {articles.map((a) => (
      <li class="note-item" data-type="article">
        <div class="meta-row">
          {a.status !== 'published' && <span class="badge badge-inbox">Bản nháp</span>}
          <span class="badge badge-type">{ARTICLE_INTENTS[a.intent as keyof typeof ARTICLE_INTENTS].label}</span>
          <span>Cập nhật {formatDate(a.updated)}</span>
        </div>
        <h3><a href={articleUrl(a.slug)}>{a.title}</a></h3>
        <p>{a.description}</p>
        {a.notes.length > 0 && <p class="stat-line" style="margin-top:0.4rem">Dựa trên: {a.notes.map((n) => n.title).join(' · ')}</p>}
      </li>
    ))}
  </ul>
)}
