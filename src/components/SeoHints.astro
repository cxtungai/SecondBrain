---
// Hộp gợi ý SEO/GEO — chỉ hiện khi chạy `npm run dev`, không bao giờ lên web.
interface Props {
  hints: { ok: boolean; label: string; tip: string }[];
  extra?: string;
}
const { hints, extra } = Astro.props;
const passed = hints.filter((h) => h.ok).length;
---

{import.meta.env.DEV && (
  <details class="card aside-block seo-hints">
    <summary><h2>SEO / GEO {passed}/{hints.length}</h2></summary>
    <p class="stat-line">Chỉ hiện khi chạy local. {extra}</p>
    <ul>
      {hints.map((h) => (
        <li class={h.ok ? 'ok' : 'todo'}>
          <span aria-hidden="true">{h.ok ? '✓' : '○'}</span> {h.label}
          {!h.ok && <small>{h.tip}</small>}
        </li>
      ))}
    </ul>
  </details>
)}
