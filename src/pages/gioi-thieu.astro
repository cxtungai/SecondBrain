---
// Trang giới thiệu & quy trình biên tập: minh bạch cách tri thức được tạo, kiểm chứng và cập nhật.
// Đây là tín hiệu tin cậy (E-E-A-T) cho người đọc, Google và AI search.
import Base from '../layouts/Base.astro';
import Credibility from '../components/Credibility.astro';
import { posts } from '../lib/posts';
import { kb } from '../lib/knowledge';
import { SITE } from '../config.mjs';
import { CREDIBILITY, STATUSES } from '../lib/schema.mjs';
import { absolute, url } from '../lib/urls';

const verified = kb.notes.filter((n) => n.status === 'verified').length;
const sources = kb.notes.reduce((sum, n) => sum + n.sources.length, 0);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Giới thiệu ${SITE.name}`,
  description: 'Cách tri thức trong kho được nghiên cứu, chấm điểm nguồn, kiểm chứng, đăng và cập nhật.',
  inLanguage: SITE.language,
  url: absolute(url('gioi-thieu/'), Astro.site),
  ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
};
---

<Base title="Giới thiệu & quy trình biên tập" description="Cách tri thức trong kho được nghiên cứu, chấm điểm nguồn, kiểm chứng, đăng và cập nhật." section="about" jsonLd={jsonLd}>
  <header class="page-head">
    <h1>Giới thiệu & quy trình biên tập</h1>
    <p class="lead">{SITE.description}</p>
    <p class="stat-line">{kb.notes.length} ghi chú · {verified} đã kiểm chứng · {sources} nguồn được dẫn · {posts.list.length} bài viết</p>
  </header>

  <div class="prose">
    <h2 id="hai-lop-noi-dung">Hai lớp nội dung</h2>
    <ul>
      <li>
        <strong><a href={url('kien-thuc/')}>Tri thức</a></strong> — ghi chú ngắn gọn, mỗi ghi chú một khái niệm, dữ kiện hay phương pháp, có nguồn
        và điểm uy tín từng nguồn. Đây là <em>nguồn sự thật</em> của trang: được viết để chính xác và dễ trích dẫn, không viết để câu view.
      </li>
      <li>
        <strong><a href={url('bai-viet/')}>Bài viết</a></strong> — trình bày lại tri thức theo những câu hỏi người đọc hay tìm (hướng dẫn, so sánh,
        cẩm nang cho người mới…). Bài viết không đưa thêm dữ kiện mới: mọi dữ kiện đều lấy từ ghi chú và có mục “Tri thức gốc” dẫn về ghi chú đó.
      </li>
    </ul>

    <h2 id="quy-trinh">Quy trình</h2>
    <ol>
      <li><strong>Nghiên cứu.</strong> AI agent tìm tài liệu từ nhiều nguồn, ưu tiên nguồn gốc (nghiên cứu, cơ quan chính thức, tài liệu của người đặt ra khái niệm), chấm điểm uy tín từng nguồn và viết bản nháp.</li>
      <li><strong>Duyệt.</strong> Người biên tập đọc, đối chiếu nguồn, sửa và chỉ đăng khi đã hiểu và đồng ý với nội dung. AI không tự đăng.</li>
      <li><strong>Kết nối.</strong> Ghi chú mới được liên kết hai chiều với tri thức liên quan và chủ đề trụ cột, để người đọc đi từ tổng quan tới chi tiết.</li>
      <li><strong>Cập nhật.</strong> Mỗi ghi chú ghi ngày cập nhật; thông tin cũ được rà soát, sửa hoặc đánh dấu “lỗi thời”.</li>
    </ol>

    <h2 id="trang-thai">Trạng thái của ghi chú</h2>
    <table class="cred-table">
      <tbody>
        {Object.entries(STATUSES).map(([key, s]) => (
          <tr><td><span class={`badge badge-status-${key}`}>{s.label}</span></td><td>{s.description}</td></tr>
        ))}
      </tbody>
    </table>

    <h2 id="thang-diem-nguon">Thang điểm uy tín nguồn</h2>
    <p>
      Mỗi nguồn được chấm từ 1 đến 5 theo năm tiêu chí: <strong>thẩm quyền</strong> (ai nói), <strong>bằng chứng</strong> (có dữ liệu, phương pháp,
      dẫn nguồn), <strong>độc lập</strong> (có bán sản phẩm hay xung đột lợi ích), <strong>thời điểm</strong> (còn mới so với chủ đề) và{' '}
      <strong>đối chiếu</strong> (nguồn độc lập khác có xác nhận). Khẳng định quan trọng cần ít nhất hai nguồn độc lập hoặc một nguồn điểm 5.
    </p>
    <table class="cred-table">
      <tbody>
        {Object.entries(CREDIBILITY).reverse().map(([score, c]) => (
          <tr><td style="white-space:nowrap"><Credibility score={Number(score)} label /></td><td>{c.description}</td></tr>
        ))}
      </tbody>
    </table>

    {SITE.disclaimer && (
      <>
        <h2 id="mien-tru">Miễn trừ trách nhiệm</h2>
        <p>{SITE.disclaimer}</p>
      </>
    )}

    <h2 id="cho-ai">Dùng kho này với AI</h2>
    <p>
      Toàn bộ tri thức được xuất dưới dạng máy đọc được (<a href={url('llms.txt')}>llms.txt</a>, <a href={url('knowledge.json')}>knowledge.json</a>)
      kèm quy tắc trích dẫn. Xem <a href={url('ai/')}>trang dành cho AI agent</a>.
    </p>
  </div>
</Base>
