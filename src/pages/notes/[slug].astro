---
import Base from '../../layouts/Base.astro';
import Credibility from '../../components/Credibility.astro';
import Graph from '../../components/Graph.astro';
import SeoHints from '../../components/SeoHints.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import { kb, type Note } from '../../lib/knowledge';
import { posts } from '../../lib/posts';
import { ARTICLE_INTENTS } from '../../lib/articles.mjs';
import { noteSeoHints } from '../../lib/seo.mjs';
import { SITE } from '../../config.mjs';
import { extractFaq, extractHeadings, renderNoteHtml } from '../../lib/render.mjs';
import { NOTE_TYPES, SOURCE_KINDS } from '../../lib/schema.mjs';
import { slugify } from '../../lib/text.mjs';
import { absolute, articleUrl, formatDate, noteMdUrl, noteUrl, tagUrl, typeUrl, url } from '../../lib/urls';

export function getStaticPaths() {
  return kb.all.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
const html = renderNoteHtml(note.body, {
  resolve: kb.resolve,
  hrefFor: (n, heading) => noteUrl(n.slug, heading),
  gapHref: (target) => url(`gaps/#${slugify(target)}`),
});
const backlinks = note.backlinks.map((s) => kb.get(s)!).filter(Boolean);
const outgoing = note.links.map((s) => kb.get(s)!).filter(Boolean);
const related = kb.notes
  .filter((n) => n.slug !== note.slug && !note.links.includes(n.slug) && !note.backlinks.includes(n.slug))
  .map((n) => ({ n, shared: n.tags.filter((t) => note.tags.includes(t)).length }))
  .filter((r) => r.shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 5)
  .map((r) => r.n);
const original = note.updates ? kb.get(note.updates) : null;
// Bài viết SEO/GEO dẫn xuất từ ghi chú này (ghi chú không tự liên kết sang bài viết).
const articles = note.inbox ? [] : posts.forNote(note.slug);
const kindLabel = (k?: string) => (k ? SOURCE_KINDS[k as keyof typeof SOURCE_KINDS] : undefined);
const typeInfo = NOTE_TYPES[note.type as keyof typeof NOTE_TYPES];

// Breadcrumb: Trang chủ › Chủ đề cha (ghi chú topic liên kết tới đây) hoặc loại › Ghi chú
const parentTopic = backlinks.find((n) => n.type === 'topic' && !n.inbox);
const crumbs = [
  { name: 'Trang chủ', href: url() },
  parentTopic ? { name: parentTopic.title, href: noteUrl(parentTopic.slug) } : { name: typeInfo.label, href: typeUrl(note.type) },
  { name: note.title, href: noteUrl(note.slug) },
];

const headings = extractHeadings(note.body);
// Mục lục 2 cấp: heading cấp 3 nằm dưới heading cấp 2 gần nhất.
const toc: { text: string; id: string; children: { text: string; id: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2 || toc.length === 0) toc.push({ text: h.text, id: h.id, children: [] });
  else toc.at(-1)!.children.push({ text: h.text, id: h.id });
}
const faq = extractFaq(note.body);

// Dữ liệu có cấu trúc giúp Google / AI hiểu và trích dẫn ghi chú.
const site = Astro.site;
const abs = (p: string) => absolute(p, site);
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': note.type === 'concept' ? ['Article', 'DefinedTerm'] : 'Article',
    headline: note.title,
    name: note.title,
    description: note.summary,
    inLanguage: SITE.language,
    datePublished: note.created,
    dateModified: note.updated,
    keywords: note.tags.join(', ') || undefined,
    url: abs(noteUrl(note.slug)),
    ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
    citation: note.sources.map((s) => (s.url ? { '@type': 'CreativeWork', name: s.title, url: s.url } : s.title)),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
  },
];
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}

// "Đọc tiếp": các ghi chú khác cùng chủ đề cha, chưa được liên kết trực tiếp.
const nextReads = parentTopic
  ? parentTopic.links.map((s) => kb.get(s)!).filter((n) => n && n.slug !== note.slug && !note.links.includes(n.slug)).slice(0, 4)
  : [];
---

<Base title={note.title} description={note.summary} ogType="article" jsonLd={note.inbox ? undefined : jsonLd} noindex={note.inbox}>
  {!note.inbox && <link slot="head" rel="alternate" type="text/markdown" title="Markdown cho AI" href={noteMdUrl(note.slug)} />}
  <div class="note-layout" data-type={note.type}>
    <article>
      <header class="note-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {crumbs.slice(0, -1).map((c) => <><a href={c.href}>{c.name}</a><span aria-hidden="true">›</span></>)}
          <span aria-current="page">{note.title}</span>
        </nav>
        <div class="meta-row">
          {note.inbox && <span class="badge badge-inbox">Chờ duyệt</span>}
          <TypeBadge type={note.type} />
          <StatusBadge status={note.status} />
          {note.credibility.rated > 0 && <Credibility score={note.credibility.average} title={`Uy tín nguồn trung bình ${note.credibility.average}/5 (${note.credibility.rated} nguồn đã chấm)`} />}
          <span>Cập nhật {formatDate(note.updated)}</span>
        </div>
        <h1>{note.title}</h1>
        <p class="note-summary">{note.summary}</p>
        {note.inbox && (
          <div class="callout callout-info">
            <strong>Bản nháp chờ duyệt</strong> — chỉ hiện khi chạy local, không lên web.
            {original && (<> Đây là bản cập nhật cho <a href={noteUrl(original.slug)}>{original.title}</a>.</>)}
            {' '}Đọc và sửa trực tiếp file <code>{note.path}</code>, xong thì đăng bằng{' '}
            <code>npm run publish -- {note.path.split('/').at(-1)}</code>.
          </div>
        )}
        {!note.inbox && note.status === 'draft' && (
          <p class="callout callout-warn">Bản nháp — chưa kiểm chứng. AI agent chỉ dùng làm gợi ý, không trích dẫn như sự thật.</p>
        )}
        {note.status === 'outdated' && <p class="callout callout-bad">Thông tin đã lỗi thời — không dùng cho content mới.</p>}
      </header>
      {headings.length >= 3 && (
        <details class="toc card" open>
          <summary>Mục lục</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.id}`}>{h.text}</a>
                {h.children.length > 0 && <ul>{h.children.map((c) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ul>}
              </li>
            ))}
            {note.sources.length > 0 && <li><a href="#nguon">Nguồn tham khảo</a></li>}
          </ol>
        </details>
      )}
      <div class="prose" set:html={html} />

      {note.sources.length > 0 && (
        <section class="prose" id="nguon">
          <h2>Nguồn tham khảo</h2>
          <ol class="source-list source-list--full">
            {note.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> : <strong>{s.title}</strong>}
                <span class="src-meta">
                  {[kindLabel(s.kind), s.author, s.publisher, s.date].filter(Boolean).join(' · ')}
                  {s.accessed && ` · truy cập ${formatDate(s.accessed)}`}
                </span>
                <span class="src-meta"><Credibility score={s.credibility} label />{s.credibility_note && ` — ${s.credibility_note}`}</span>
                {s.note && <span class="src-meta">{s.note}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {nextReads.length > 0 && parentTopic && (
        <section class="next-steps">
          <h2 class="section-title">Đọc tiếp trong “{parentTopic.title}”</h2>
          <div class="grid">
            {nextReads.map((n) => (
              <a class="card" href={noteUrl(n.slug)} data-type={n.type}>
                <span class="badge badge-type">{NOTE_TYPES[n.type as keyof typeof NOTE_TYPES].label}</span>
                <strong style="display:block;margin-top:0.4rem">{n.title}</strong>
                <span class="stat-line" style="display:block;margin-top:0.25rem">{n.summary}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

    <aside class="note-aside">
      <div class="card aside-block">
        <h2>Thông tin</h2>
        <dl>
          <dt>Tạo</dt><dd>{formatDate(note.created)}</dd>
          <dt>Cập nhật</dt><dd>{formatDate(note.updated)}</dd>
          {note.reviewed && (<><dt>Đã duyệt</dt><dd>{formatDate(note.reviewed)}</dd></>)}
          <dt>Độ dài</dt><dd>{note.wordCount} từ</dd>
          <dt>Nguồn</dt>
          <dd>
            {note.sources.length === 0 ? 'chưa có' : <a href="#nguon">{note.sources.length} nguồn</a>}
            {note.credibility.rated > 0 && <> · <Credibility score={note.credibility.average} /></>}
          </dd>
          {note.research?.keyword && (<><dt>Từ khoá</dt><dd>{note.research.keyword}</dd></>)}
          {note.aliases.length > 0 && (<><dt>Tên khác</dt><dd>{note.aliases.join(', ')}</dd></>)}
        </dl>
        {note.tags.length > 0 && (
          <div class="meta-row" style="margin-top:0.75rem">
            {note.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>#{tag}</a>)}
          </div>
        )}
      </div>

      {(note.links.length > 0 || note.backlinks.length > 0) && (
        <div class="card aside-block">
          <h2>Bản đồ liên kết</h2>
          <Graph focus={note.slug} height={220} />
        </div>
      )}

      {backlinks.length > 0 && (
        <div class="card aside-block">
          <h2>Được nhắc đến trong ({backlinks.length})</h2>
          <ul>{backlinks.map((n) => <li><a href={noteUrl(n.slug)}>{n.title}</a></li>)}</ul>
        </div>
      )}

      {outgoing.length > 0 && (
        <div class="card aside-block">
          <h2>Liên kết tới ({outgoing.length})</h2>
          <ul>{outgoing.map((n) => <li><a href={noteUrl(n.slug)}>{n.title}</a></li>)}</ul>
        </div>
      )}

      {note.brokenLinks.length > 0 && (
        <div class="card aside-block">
          <h2>Cần nghiên cứu thêm ({note.brokenLinks.length})</h2>
          <ul>{note.brokenLinks.map((t) => <li><a class="wikilink--broken" href={url(`gaps/#${slugify(t)}`)}>{t}</a></li>)}</ul>
        </div>
      )}

      {articles.length > 0 && (
        <div class="card aside-block" data-type="article">
          <h2>Bài viết về chủ đề này ({articles.length})</h2>
          <ul>
            {articles.map((a) => (
              <li>
                <a href={articleUrl(a.slug)}>{a.title}</a>
                <small class="stat-line" style="display:block">{ARTICLE_INTENTS[a.intent as keyof typeof ARTICLE_INTENTS].label}{a.status !== 'published' && ' · bản nháp'}</small>
              </li>
            ))}
          </ul>
        </div>
      )}

      {related.length > 0 && (
        <div class="card aside-block">
          <h2>Cùng chủ đề</h2>
          <ul>{related.map((n) => <li><a href={noteUrl(n.slug)}>{n.title}</a></li>)}</ul>
        </div>
      )}

      <SeoHints hints={noteSeoHints(note)} extra="Gợi ý chỉ nhằm làm tri thức rõ và đáng tin hơn — không nhồi từ khoá vào ghi chú." />

      {!note.inbox && (
        <div class="card aside-block">
          <h2>Cho AI agent</h2>
          <ul>
            <li><a href={noteMdUrl(note.slug)}>Bản Markdown của ghi chú</a></li>
            <li><code>{note.path}</code></li>
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
