---
import Base from '../layouts/Base.astro';
import { kb } from '../lib/knowledge';
import { noteUrl } from '../lib/urls';
---

<Base title="Tri thức còn thiếu" description="Các khái niệm đã được nhắc tới bằng [[liên kết]] nhưng chưa có ghi chú — hàng đợi nghiên cứu tiếp theo." section="hub" noindex>
  <header class="page-head">
    <h1>Tri thức còn thiếu</h1>
    <p class="lead">
      Các khái niệm đã được nhắc tới bằng <code>[[liên kết]]</code> nhưng chưa có ghi chú. Đây là hàng đợi nghiên cứu: nhờ AI agent tìm hiểu bằng
      <code>/research &lt;tên&gt;</code>, rồi duyệt và đăng.
    </p>
  </header>
  {kb.gaps.length === 0 ? (
    <p class="empty">Không còn liên kết nào bị thiếu. Mọi [[liên kết]] đều đã có ghi chú.</p>
  ) : (
    <ul class="note-list">
      {kb.gaps.map((g) => (
        <li class="note-item" id={g.slug}>
          <h3 style="margin-top:0">{g.name}</h3>
          <p>
            Được nhắc trong {g.from.length} ghi chú:{' '}
            {g.from.map((s, i) => {
              const n = kb.get(s);
              return n ? <>{i > 0 && ', '}<a href={noteUrl(n.slug)}>{n.title}</a></> : null;
            })}
          </p>
          <p class="stat-line">Nghiên cứu: <code>/research {g.name}</code> · hoặc tạo tay: <code>npm run new -- concept "{g.name}"</code></p>
        </li>
      ))}
    </ul>
  )}
</Base>
