---
import Base from '../layouts/Base.astro';
import { AGENT_RULES } from '../config.mjs';
import { kb } from '../lib/knowledge';
import { absolute, url } from '../lib/urls';

const site = Astro.site;
const abs = (p: string) => absolute(url(p), site);
const exampleSlug = kb.byType('topic')[0]?.slug ?? kb.notes[0]?.slug ?? 'ten-ghi-chu';

const endpoints = [
  { path: 'llms.txt', title: 'llms.txt — chỉ mục', desc: 'Danh sách mọi ghi chú theo loại, kèm tóm tắt, trạng thái và quy tắc sử dụng. Agent nên đọc file này đầu tiên.' },
  { path: 'llms-full.txt', title: 'llms-full.txt — toàn bộ nội dung', desc: 'Tất cả ghi chú trong một file, phù hợp khi kho còn nhỏ hoặc agent có context lớn.' },
  { path: 'knowledge.json', title: 'knowledge.json — dữ liệu có cấu trúc', desc: 'Metadata, liên kết, backlinks và nội dung từng ghi chú — dùng cho tool/script tự lọc theo type, status, tags.' },
  { path: `notes/${exampleSlug}.md`, title: 'notes/<slug>.md — từng ghi chú', desc: 'Markdown thuần của một ghi chú (wikilink đã đổi thành link chuẩn). Mỗi trang ghi chú đều có bản này.' },
];

const prompt = `Bạn là người viết content. Nguồn tri thức duy nhất được phép dùng cho dữ kiện là Second Brain tại:
${abs('llms.txt')}

Quy trình:
1. Đọc llms.txt để xem kho có những ghi chú nào.
2. Chọn các ghi chú liên quan tới đề bài (ưu tiên ghi chú loại "Chủ đề" trước, rồi đi theo liên kết), đọc bản .md của chúng.
3. Lập dàn ý dựa trên kiến thức trong kho, sau đó viết bài.
4. Cuối bài, liệt kê các ghi chú và nguồn đã dùng.

Quy tắc:
${AGENT_RULES.map((r) => `- ${r}`).join('\n')}

Đề bài: <mô tả bài cần viết, kênh đăng, độ dài, giọng văn>`;
---

<Base title="Cho AI agent" section="ai">
  <header class="page-head">
    <h1>Kết nối AI agent</h1>
    <p class="lead">
      Second Brain xuất toàn bộ tri thức thành các file tĩnh mà mọi AI agent đều đọc được — không cần API key hay server.
      Agent làm việc trực tiếp trong repo (Claude Code, Cursor…) có thể đọc thẳng thư mục <code>knowledge/</code> theo hướng dẫn trong <code>AGENTS.md</code>.
    </p>
  </header>

  <section class="section">
    <h2 class="section-title">Các nguồn dữ liệu</h2>
    <div class="grid">
      {endpoints.map((e) => (
        <div class="card endpoint">
          <strong>{e.title}</strong>
          <a href={url(e.path)}><code>{abs(e.path)}</code></a>
          <span class="stat-line" style="margin:0">{e.desc}</span>
        </div>
      ))}
    </div>
    {!site && (
      <p class="callout callout-info">
        Đang chạy local nên URL là đường dẫn tương đối. Khi deploy, đặt biến <code>SITE_URL</code> để các link trong llms.txt là URL tuyệt đối.
      </p>
    )}
  </section>

  <section class="section">
    <h2 class="section-title">Quy tắc agent phải tuân theo</h2>
    <ul>{AGENT_RULES.map((r) => <li>{r}</li>)}</ul>
    <p class="stat-line">Sửa quy tắc trong <code>src/config.mjs</code>.</p>
  </section>

  <section class="section">
    <h2 class="section-title">Prompt mẫu cho agent viết content</h2>
    <div class="copy-wrap">
      <button class="copy-btn" type="button" data-copy="#agent-prompt">Sao chép</button>
      <pre id="agent-prompt">{prompt}</pre>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = document.querySelector(btn.dataset.copy!);
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.textContent ?? '');
        btn.textContent = 'Đã chép';
      } catch {
        btn.textContent = 'Không chép được';
      }
      setTimeout(() => (btn.textContent = 'Sao chép'), 1500);
    });
  });
</script>
