---
import Base from '../../layouts/Base.astro';
import Credibility from '../../components/Credibility.astro';
import SeoHints from '../../components/SeoHints.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TypeBadge from '../../components/TypeBadge.astro';
import { posts, type Article } from '../../lib/posts';
import { ARTICLE_INTENTS } from '../../lib/articles.mjs';
import { kb } from '../../lib/knowledge';
import { SITE } from '../../config.mjs';
import { extractFaq, extractHeadings, renderNoteHtml } from '../../lib/render.mjs';
import { articleSeoHints } from '../../lib/seo.mjs';
import { slugify } from '../../lib/text.mjs';
import { absolute, articleUrl, formatDate, noteUrl, url } from '../../lib/urls';

export function getStaticPaths() {
  return posts.all.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const draft = article.status !== 'published';
const html = renderNoteHtml(article.body, {
  // Bài viết liên kết tới ghi chú tri thức (ưu tiên) hoặc bài viết khác.
  resolve: (t: string) => kb.resolve(t) ?? posts.resolve(t),
  hrefFor: (item: { kind?: string; slug: string }, heading?: string) => (item.kind === 'article' ? articleUrl(item.slug) : noteUrl(item.slug, heading)),
  gapHref: (target: string) => url(`gaps/#${slugify(target)}`),
});
const intent = ARTICLE_INTENTS[article.intent as keyof typeof ARTICLE_INTENTS];
const basis = article.notes;
const mentioned = article.links.map((s) => kb.get(s)!).filter((n) => n && !basis.includes(n));
const related = posts.related(article);
const sources = basis.reduce((sum, n) => sum + n.sources.length, 0);
const rated = basis.flatMap((n) => n.sources.map((s) => s.credibility).filter((c): c is number => typeof c === 'number'));
const avgCred = rated.length ? Math.round((rated.reduce((a, b) => a + b, 0) / rated.length) * 10) / 10 : null;
const readMinutes = Math.max(1, Math.round(article.wordCount / 220));
const published = article.publishedOn ?? article.created;

const crumbs = [
  { name: 'Trang chủ', href: url() },
  { name: 'Bài viết', href: url('bai-viet/') },
  { name: article.title, href: articleUrl(article.slug) },
];

const headings = extractHeadings(article.body);
const toc: { text: string; id: string; children: { text: string; id: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2 || toc.length === 0) toc.push({ text: h.text, id: h.id, children: [] });
  else toc.at(-1)!.children.push({ text: h.text, id: h.id });
}
const faq = extractFaq(article.body);

const site = Astro.site;
const abs = (p: string) => absolute(p, site);
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    inLanguage: SITE.language,
    datePublished: published,
    dateModified: article.updated,
    keywords: [article.keyword, ...article.keywords].join(', '),
    url: abs(articleUrl(article.slug)),
    ...(SITE.author ? { author: { '@type': 'Person', name: SITE.author } } : {}),
    // Bài viết dẫn xuất từ các ghi chú tri thức — tín hiệu nguồn gốc cho Google / AI.
    isBasedOn: basis.map((n) => ({ '@type': 'CreativeWork', name: n.title, url: abs(noteUrl(n.slug)) })),
    about: basis.map((n) => ({ '@type': 'Thing', name: n.title, url: abs(noteUrl(n.slug)) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
  },
];
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}
---

<Base title={article.title} description={article.description} section="articles" ogType="article" jsonLd={draft ? undefined : jsonLd} noindex={draft}>
  <div class="note-layout" data-type="article">
    <article>
      <header class="note-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {crumbs.slice(0, -1).map((c) => <><a href={c.href}>{c.name}</a><span aria-hidden="true">›</span></>)}
          <span aria-current="page">{article.title}</span>
        </nav>
        <div class="meta-row">
          {draft && <span class="badge badge-inbox">Bản nháp</span>}
          <span class="badge badge-type">Bài viết · {intent.label}</span>
          <span>Cập nhật {formatDate(article.updated)}</span>
          <span>{readMinutes} phút đọc</span>
        </div>
        <h1>{article.title}</h1>
        <p class="note-summary">{article.description}</p>
        {draft && (
          <div class="callout callout-info">
            <strong>Bài viết nháp</strong> — chỉ hiện khi chạy local, không lên web. Sửa file <code>{article.path}</code>, xong thì đăng bằng{' '}
            <code>npm run publish -- {article.path}</code>.
          </div>
        )}
      </header>

      {headings.length >= 3 && (
        <details class="toc card" open>
          <summary>Mục lục</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.id}`}>{h.text}</a>
                {h.children.length > 0 && <ul>{h.children.map((c) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ul>}
              </li>
            ))}
            {basis.length > 0 && <li><a href="#tri-thuc-goc">Tri thức gốc</a></li>}
          </ol>
        </details>
      )}

      <div class="prose" set:html={html} />

      {basis.length > 0 && (
        <section class="basis" id="tri-thuc-goc">
          <h2 class="section-title">Tri thức gốc của bài viết</h2>
          <p class="stat-line">
            Dữ kiện trong bài lấy từ các ghi chú dưới đây — nơi ghi đầy đủ nguồn tham khảo và điểm uy tín của từng nguồn.
          </p>
          <ul class="note-list">
            {basis.map((n) => (
              <li class="note-item" data-type={n.type}>
                <div class="meta-row">
                  <TypeBadge type={n.type} />
                  <StatusBadge status={n.status} />
                  {n.credibility.rated > 0 && <Credibility score={n.credibility.average} />}
                  <span>{n.sources.length} nguồn · cập nhật {formatDate(n.updated)}</span>
                </div>
                <h3><a href={noteUrl(n.slug)}>{n.title}</a></h3>
                <p>{n.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section class="next-steps">
          <h2 class="section-title">Bài viết liên quan</h2>
          <div class="grid">
            {related.map((a) => (
              <a class="card" href={articleUrl(a.slug)} data-type="article">
                <span class="badge badge-type">{ARTICLE_INTENTS[a.intent as keyof typeof ARTICLE_INTENTS].label}</span>
                <strong style="display:block;margin-top:0.4rem">{a.title}</strong>
                <span class="stat-line" style="display:block;margin-top:0.25rem">{a.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {SITE.disclaimer && <p class="disclaimer">{SITE.disclaimer}</p>}
    </article>

    <aside class="note-aside">
      <div class="card aside-block">
        <h2>Thông tin</h2>
        <dl>
          <dt>Đăng</dt><dd>{formatDate(published)}</dd>
          <dt>Cập nhật</dt><dd>{formatDate(article.updated)}</dd>
          <dt>Độ dài</dt><dd>{article.wordCount} từ · {readMinutes} phút</dd>
          <dt>Dựa trên</dt><dd><a href="#tri-thuc-goc">{basis.length} ghi chú</a></dd>
          <dt>Nguồn</dt>
          <dd>{sources} nguồn{avgCred !== null && <> · <Credibility score={avgCred} /></>}</dd>
        </dl>
      </div>

      {mentioned.length > 0 && (
        <div class="card aside-block">
          <h2>Ghi chú được nhắc tới</h2>
          <ul>{mentioned.map((n) => <li><a href={noteUrl(n.slug)}>{n.title}</a></li>)}</ul>
        </div>
      )}

      <SeoHints hints={articleSeoHints(article)} extra={`Từ khoá chính: “${article.keyword}”${article.keywords.length ? ` · phụ: ${article.keywords.join(', ')}` : ''} · intent: ${intent.label}`} />
    </aside>
  </div>
</Base>
