---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { posts } from '../../lib/posts';
import { ARTICLE_INTENTS } from '../../lib/articles.mjs';
import { url } from '../../lib/urls';

const groups = Object.entries(ARTICLE_INTENTS)
  .map(([key, info]) => ({ key, ...info, items: posts.all.filter((a) => a.intent === key) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Bài viết" description="Bài viết dễ đọc theo những câu hỏi người đọc hay tìm — mỗi bài dựa trên các ghi chú tri thức có nguồn." section="articles">
  <header class="page-head">
    <h1>Bài viết</h1>
    <p class="lead">
      Bài viết dễ đọc theo những câu hỏi người đọc hay tìm. Mỗi bài được viết <strong>từ các ghi chú tri thức</strong> — cuối bài có mục
      “Tri thức gốc” dẫn về ghi chú chứa đầy đủ nguồn và điểm uy tín. Muốn tra cứu chính xác, xem <a href={url('kien-thuc/')}>Trung tâm kiến thức</a>.
    </p>
  </header>

  {groups.length === 0 ? (
    <p class="empty">Chưa có bài viết nào. Viết bài đầu tiên bằng <code>/seo-article &lt;từ khoá&gt;</code> trong Claude Code.</p>
  ) : (
    groups.map((g) => (
      <section class="section">
        <h2 class="section-title">{g.label} <span class="stat-line" style="margin:0">{g.items.length} bài</span></h2>
        <ArticleList articles={g.items} />
      </section>
    ))
  )}
</Base>
