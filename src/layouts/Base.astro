---
import '../styles/global.css';
import { SITE } from '../config.mjs';
import { url } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  /** Dùng để đánh dấu mục menu đang mở */
  section?: 'home' | 'hub' | 'glossary' | 'graph' | 'types' | 'tags' | 'search' | 'ai';
  /** og:type — "article" cho trang ghi chú */
  ogType?: 'website' | 'article';
  /** Dữ liệu có cấu trúc schema.org (JSON-LD) */
  jsonLd?: object | object[];
  /** Không cho công cụ tìm kiếm lập chỉ mục (vd. bản nháp chờ duyệt) */
  noindex?: boolean;
}

const SITE_NAME = SITE.name;
const { title, description = SITE.description, section, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const nav = [
  { key: 'hub', href: url('kien-thuc/'), label: 'Kiến thức' },
  { key: 'glossary', href: url('tu-dien/'), label: 'Từ điển' },
  { key: 'graph', href: url('graph/'), label: 'Đồ thị' },
  { key: 'search', href: url('search/'), label: 'Tìm kiếm' },
  { key: 'ai', href: url('ai/'), label: 'Cho AI' },
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={SITE.locale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="sitemap" href={url('sitemap.xml')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href={url('llms.txt')} />
    <link rel="alternate" type="application/json" title="Knowledge index" href={url('knowledge.json')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url()}><span class="brand-mark" aria-hidden="true"></span>{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Điều hướng chính">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        {section !== 'search' && (
          <form class="header-search" action={url('search/')} method="get" role="search">
            <input type="search" name="q" placeholder="Tìm ghi chú…" aria-label="Tìm ghi chú" />
          </form>
        )}
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Second Brain — kho tri thức cho người và AI agent.</span>
        <span><a href={url('llms.txt')}>llms.txt</a> · <a href={url('knowledge.json')}>knowledge.json</a></span>
      </div>
    </footer>
  </body>
</html>
